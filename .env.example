# Free token: https://app.travelpayouts.com/profile/api-token
TRAVELPAYOUTS_TOKEN=
# Optional affiliate marker, appended to Aviasales booking links
TRAVELPAYOUTS_MARKER=
# Children priced as this fraction of an adult ticket when scaling the estimate
FM_CHILD_FACTOR=1.0

# Direct-carrier sources, layered onto discovery and used to fill a grid the aggregators
# leave empty on a route the carrier flies. Keyless. Set to 0 to disable.
#   FM_WIZZ     — Wizz Air's booking calendar (small routes booked far out)
#   FM_RYANAIR  — Ryanair fare-finder (no Israeli airports; the board from a Ryanair base)
# FM_WIZZ=1
# FM_RYANAIR=1
# FM_AIRLINE_FILL_CAP=12

# Route ONLY Kiwi's calls through a proxy (Google + Travelpayouts stay direct), to get
# off the datacenter IP Kiwi rate-limits hardest. A residential/mobile proxy works best;
# free-trial pools (Luna, NodeMaven, ~1 GB) are enough to evaluate it.
# FM_KIWI_PROXY=http://user:pass@host:port
# Fall back to a direct connection once this many MB have gone through the proxy
# (guards a metered/trial proxy). Cumulative; delete data/kiwi_proxy_usage.json to reset.
# FM_KIWI_PROXY_BUDGET_MB=950

# Extra Google Flights relays (relay/app.py, deploy/provision_relay.sh): each is a small
# extra VM doing lookups from its own IP, so verify() calls spread across boxes instead
# of concentrating on this one. Comma-separated base URLs, PRIVATE IPs if the relay is in
# the same OCI VCN (VM-to-VM over public IPs doesn't reliably route there).
# FM_GOOGLE_RELAYS=http://10.0.0.126:8080
